{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "vite build",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/orbitals", "destination": "/orbitals.html" },
    { "source": "/mo", "destination": "/mo.html" },
    { "source": "/em", "destination": "/em.html" },
    { "source": "/thermo", "destination": "/thermo.html" },
    { "source": "/relativity", "destination": "/relativity.html" },
    { "source": "/segre", "destination": "/segre.html" },
    { "source": "/daedalus", "destination": "/daedalus.html" },
    { "source": "/references", "destination": "/references.html" },
    { "source": "/synthesizer", "destination": "/synthesizer.html" },
    { "source": "/integrity", "destination": "/integrity.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
