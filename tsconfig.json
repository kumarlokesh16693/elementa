{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "jsx": "react-jsx",
    "strict": true,
    "noImplicitAny": false,
    "resolveJsonModule": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "noEmit": true,
    "types": [],
    "paths": {
      "@/*": ["./src/*"],
      "nexus-framework": ["../../index.d.ts"],
      "@nexus/3d": ["../../packages/3D/nexus/nexus-3d/src/index.ts"],
      "@nexus/3d-post": ["../../packages/3D/nexus/nexus-3d-post/src/index.ts"]
    }
  },
  "include": ["src", "vite.config.ts"]
}
