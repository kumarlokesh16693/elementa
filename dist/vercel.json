{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo 'Prebuilt production bundle ready'",
  "outputDirectory": "dist",
  "cleanUrls": true,
  "trailingSlash": false,
  "rewrites": [
    { "source": "/orbitals", "destination": "/orbitals.html" },
    { "source": "/mo", "destination": "/mo.html" },
    { "source": "/segre", "destination": "/segre.html" },
    { "source": "/daedalus", "destination": "/daedalus.html" },
    { "source": "/references", "destination": "/references.html" },
    { "source": "/integrity", "destination": "/integrity.html" }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ]
}
